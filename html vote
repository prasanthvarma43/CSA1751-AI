```html
<!DOCTYPE html>
<html>
<head>
    <title>VoteOnline - E-Voting System</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>VoteOnline</h1>
    <p>Secure Online Voting System</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#login">Login</a>
    <a href="#vote">Vote</a>
    <a href="#history">Voting History</a>
    <a href="#admin">Admin</a>
</nav>

<!-- Home -->
<section id="home">
    <h2>Welcome to VoteOnline</h2>
    <p>Vote securely and easily from anywhere.</p>
</section>

<!-- Voter Login -->
<section id="login">
    <h2>Voter Login</h2>

    <form>
        <label>Voter ID:</label>
        <input type="text" placeholder="Enter Voter ID">

        <label>Password:</label>
        <input type="password" placeholder="Enter Password">

        <button type="submit">Login</button>
    </form>
</section>

<!-- OTP Verification -->
<section>
    <h2>OTP Verification</h2>

    <form>
        <label>Enter OTP:</label>
        <input type="text" placeholder="Enter OTP">

        <button type="submit">Verify OTP</button>
    </form>
</section>

<!-- Voting -->
<section id="vote">
    <h2>Cast Your Vote</h2>

    <form>
        <label>Select Candidate:</label>

        <select>
            <option>Candidate A</option>
            <option>Candidate B</option>
            <option>Candidate C</option>
        </select>

        <label>Voting OTP:</label>
        <input type="text" placeholder="Enter Voting OTP">

        <button type="submit">Submit Vote</button>
    </form>
</section>

<!-- Voting History -->
<section id="history">
    <h2>Voting History</h2>

    <table>
        <tr>
            <th>Election</th>
            <th>Candidate</th>
            <th>Status</th>
        </tr>

        <tr>
            <td>2026 General Election</td>
            <td>Candidate A</td>
            <td>Vote Submitted</td>
        </tr>
    </table>
</section>

<!-- Admin -->
<section id="admin">
    <h2>Admin Panel</h2>

    <button>Create Election</button>
    <button>Create Candidate</button>
    <button>Create Voter List</button>
    <button>Import Voter List</button>
    <button>View / Update Voters</button>
    <button>Get Election Results</button>

    <h3>Candidate List</h3>

    <table>
        <tr>
            <th>Candidate ID</th>
            <th>Candidate Name</th>
            <th>Election</th>
        </tr>

        <tr>
            <td>C01</td>
            <td>Candidate A</td>
            <td>General Election</td>
        </tr>

        <tr>
            <td>C02</td>
            <td>Candidate B</td>
            <td>General Election</td>
        </tr>
    </table>
</section>

<!-- Results -->
<section>
    <h2>Election Results</h2>

    <table>
        <tr>
            <th>Candidate</th>
            <th>Votes</th>
        </tr>

        <tr>
            <td>Candidate A</td>
            <td>120</td>
        </tr>

        <tr>
            <td>Candidate B</td>
            <td>95</td>
        </tr>
    </table>
</section>

<footer>
    <p>&copy; 2026 VoteOnline | Secure E-Voting System</p>
</footer>

</body>
</html>
```
