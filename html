```html
<!DOCTYPE html>
<html>
<head>
    <title>Railway Reservation System</title>

    <!-- Connecting CSS file -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <h1>Railway Reservation System</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#search">Search Train</a>
            <a href="#booking">Booking</a>
            <a href="#pnr">PNR Status</a>
            <a href="#login">Login</a>
        </nav>
    </header>


    <!-- Home -->
    <section id="home" class="home">

        <h2>Welcome to Railway Reservation</h2>

        <p>Book your train tickets easily and quickly.</p>

        <button>Book Ticket</button>

    </section>


    <!-- Search Train -->
    <section id="search">

        <h2>Search Train</h2>

        <form>

            <label>From Station:</label>
            <input type="text"
                   placeholder="Enter origin station">

            <label>To Station:</label>
            <input type="text"
                   placeholder="Enter destination station">

            <label>Journey Date:</label>
            <input type="date">

            <label>Class:</label>

            <select>
                <option>Sleeper</option>
                <option>AC 3 Tier</option>
                <option>AC 2 Tier</option>
                <option>First Class</option>
            </select>

            <button type="submit">
                Search Train
            </button>

        </form>

    </section>


    <!-- Available Trains -->
    <section>

        <h2>Available Trains</h2>

        <table>

            <tr>
                <th>Train No</th>
                <th>Train Name</th>
                <th>From</th>
                <th>To</th>
                <th>Seats</th>
            </tr>

            <tr>
                <td>12001</td>
                <td>Chennai Express</td>
                <td>Chennai</td>
                <td>Bengaluru</td>
                <td>45</td>
            </tr>

            <tr>
                <td>12841</td>
                <td>Coromandel Express</td>
                <td>Chennai</td>
                <td>Hyderabad</td>
                <td>30</td>
            </tr>

            <tr>
                <td>12711</td>
                <td>Superfast Express</td>
                <td>Chennai</td>
                <td>Vijayawada</td>
                <td>20</td>
            </tr>

        </table>

    </section>


    <!-- Ticket Booking -->
    <section id="booking">

        <h2>Ticket Booking</h2>

        <form>

            <label>Passenger Name:</label>
            <input type="text"
                   placeholder="Enter passenger name">

            <label>Age:</label>
            <input type="number"
                   placeholder="Enter age">

            <label>Gender:</label>

            <select>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
            </select>

            <label>Train:</label>

            <select>
                <option>Chennai Express</option>
                <option>Coromandel Express</option>
                <option>Superfast Express</option>
            </select>

            <label>Payment Method:</label>

            <select>
                <option>Online Payment</option>
                <option>Offline Payment</option>
            </select>

            <button type="submit">
                Book Ticket
            </button>

        </form>

    </section>


    <!-- PNR Status -->
    <section id="pnr">

        <h2>Check PNR Status</h2>

        <input type="text"
               placeholder="Enter PNR Number">

        <button>
            Check Status
        </button>

        <p>
            <b>Status:</b> CONFIRMED
        </p>

    </section>


    <!-- Login -->
    <section id="login">

        <h2>Passenger Login</h2>

        <form>

            <label>Email:</label>

            <input type="email"
                   placeholder="Enter email">

            <label>Password:</label>

            <input type="password"
                   placeholder="Enter password">

            <button type="submit">
                Login
            </button>

        </form>

    </section>


    <!-- Footer -->
    <footer>

        <p>
            © 2026 Railway Reservation System
        </p>

    </footer>

</body>
</html>
```
