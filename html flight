```html
<!DOCTYPE html>
<html>
<head>
    <title>Flight Reservation</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>Flight Reservation System</h1>

    <nav>
        <a href="#home">Home</a>
        <a href="#search">Search</a>
        <a href="#booking">Booking</a>
        <a href="#login">Login</a>
    </nav>
</header>


<!-- Home -->
<section id="home">
    <h2>Welcome to Flight Reservation</h2>
    <p>Book your flight ticket easily.</p>
</section>


<!-- Search Flight -->
<section id="search">
    <h2>Search Flight</h2>

    <form>
        <label>From:</label>
        <input type="text" placeholder="Departure">

        <label>To:</label>
        <input type="text" placeholder="Destination">

        <label>Date:</label>
        <input type="date">

        <label>Class:</label>
        <select>
            <option>Economy</option>
            <option>Business</option>
            <option>First Class</option>
        </select>

        <button>Search Flight</button>
    </form>
</section>


<!-- Available Flights -->
<section>
    <h2>Available Flights</h2>

    <table>
        <tr>
            <th>Flight</th>
            <th>Airline</th>
            <th>Time</th>
            <th>Seats</th>
            <th>Fare</th>
        </tr>

        <tr>
            <td>AI101</td>
            <td>Air India</td>
            <td>8:00 AM</td>
            <td>30</td>
            <td>₹5000</td>
        </tr>

        <tr>
            <td>6E202</td>
            <td>IndiGo</td>
            <td>10:00 AM</td>
            <td>25</td>
            <td>₹4500</td>
        </tr>
    </table>
</section>


<!-- Booking -->
<section id="booking">
    <h2>Book Ticket</h2>

    <form>
        <label>Passenger Name:</label>
        <input type="text">

        <label>Flight:</label>
        <select>
            <option>Air India</option>
            <option>IndiGo</option>
        </select>

        <label>Seat:</label>
        <select>
            <option>1A</option>
            <option>1B</option>
            <option>2A</option>
            <option>2B</option>
        </select>

        <button>Book Ticket</button>
    </form>
</section>


<!-- Login -->
<section id="login">
    <h2>Login</h2>

    <form>
        <label>Email:</label>
        <input type="email">

        <label>Password:</label>
        <input type="password">

        <button>Login</button>
    </form>

    <p>Forgot Password?</p>
</section>


<!-- Ticket -->
<section>
    <h2>My Ticket</h2>

    <p>Ticket No: FT101</p>
    <p>Flight: Air India</p>
    <p>Status: Confirmed</p>

    <button>Print Ticket</button>
</section>


<!-- Cancel -->
<section>
    <h2>Cancel Ticket</h2>

    <input type="text" placeholder="Enter Ticket Number">
    <button>Cancel Ticket</button>
</section>


<!-- Feedback -->
<section>
    <h2>Customer Feedback</h2>

    <textarea placeholder="Enter your feedback"></textarea>

    <br><br>

    <button>Submit</button>
</section>


<footer>
    <p>© 2026 Flight Reservation System</p>
</footer>

</body>
</html>
```
