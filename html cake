```html
<!DOCTYPE html>
<html>
<head>
    <title>Buy a Cake</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>Buy a Cake</h1>
    <p>Online Cake Ordering System</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#login">Login</a>
    <a href="#cakes">Cakes</a>
    <a href="#order">Order</a>
</nav>

<section id="home">
    <h2>Welcome</h2>
    <p>Order delicious cakes online.</p>
</section>

<section id="login">
    <h2>Login</h2>
    <form>
        <input type="text" placeholder="Voter/User ID">
        <input type="password" placeholder="Password">
        <button>Login</button>
    </form>
</section>

<section id="cakes">
    <h2>Available Cakes</h2>

    <div class="cake">
        <h3>Chocolate Cake</h3>
        <p>Price: ₹800</p>
        <p>Category: Birthday</p>
        <button>Add to Cart</button>
    </div>

    <div class="cake">
        <h3>Black Forest Cake</h3>
        <p>Price: ₹1000</p>
        <p>Category: Anniversary</p>
        <button>Add to Cart</button>
    </div>
</section>

<section>
    <h2>Search Cake</h2>

    <form>
        <input type="text" placeholder="Search Cake">

        <select>
            <option>Birthday</option>
            <option>Wedding</option>
            <option>Anniversary</option>
        </select>

        <select>
            <option>₹500 - ₹1000</option>
            <option>₹1000 - ₹1500</option>
        </select>

        <button>Search</button>
    </form>
</section>

<section id="order">
    <h2>Place Order</h2>

    <form>
        <input type="text" placeholder="Cake Name">
        <input type="text" placeholder="Delivery Address">
        <input type="text" placeholder="Phone Number">

        <button>Place Order</button>
    </form>
</section>

<section>
    <h2>My Orders</h2>

    <table>
        <tr>
            <th>Cake</th>
            <th>Price</th>
            <th>Status</th>
        </tr>

        <tr>
            <td>Chocolate Cake</td>
            <td>₹800</td>
            <td>Out for Delivery</td>
        </tr>
    </table>
</section>

<footer>
    <p>© 2026 Buy a Cake</p>
</footer>

</body>
</html>
```
