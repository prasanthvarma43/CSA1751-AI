```css
body {
    margin: 0;
    font-family: Arial;
    background-color: #f2f2f2;
}


/* Header */

header {
    background-color: #003366;
    color: white;
    text-align: center;
    padding: 20px;
}


/* Navigation */

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
}


/* Section */

section {
    background-color: white;
    width: 80%;
    margin: 20px auto;
    padding: 20px;
    border-radius: 10px;
}


/* Heading */

h2 {
    color: #003366;
    text-align: center;
}


/* Form */

form {
    width: 70%;
    margin: auto;
}

label {
    display: block;
    margin-top: 10px;
}

input,
select,
textarea {
    width: 100%;
    padding: 10px;
    margin: 8px 0;
}


/* Button */

button {
    background-color: #003366;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
}


/* Table */

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    border: 1px solid black;
    padding: 10px;
    text-align: center;
}

th {
    background-color: #003366;
    color: white;
}


/* Footer */

footer {
    background-color: #003366;
    color: white;
    text-align: center;
    padding: 15px;
}


/* Mobile */

@media(max-width:600px) {

    section {
        width: 90%;
    }

    form {
        width: 100%;
    }

    nav a {
        display: block;
        margin: 10px;
    }
}
```
