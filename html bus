```html
<!DOCTYPE html>
<html>

<head>
    <title>Online Bus Ticket Booking</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header>

        <h1>Online Bus Ticket Booking</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#search">Search Bus</a>
            <a href="#booking">Book Ticket</a>
            <a href="#history">Booking History</a>
            <a href="#login">Login</a>
            <a href="#contact">Contact</a>
        </nav>

    </header>


    <!-- Home -->
    <section id="home" class="home">

        <h2>Welcome to Online Bus Booking</h2>

        <p>
            Search and book bus tickets easily and quickly.
        </p>

        <button>Book Now</button>

    </section>


    <!-- Search Bus -->
    <section id="search">

        <h2>Search Bus</h2>

        <form>

            <label>From:</label>
            <input type="text"
                   placeholder="Enter starting location">

            <label>To:</label>
            <input type="text"
                   placeholder="Enter destination">

            <label>Journey Date:</label>
            <input type="date">

            <label>Journey Time:</label>
            <input type="time">

            <button type="submit">
                Search Bus
            </button>

        </form>

    </section>


    <!-- Available Buses -->
    <section>

        <h2>Available Buses</h2>

        <table>

            <tr>
                <th>Bus No</th>
                <th>Bus Name</th>
                <th>Type</th>
                <th>Time</th>
                <th>Seats</th>
                <th>Fare</th>
            </tr>

            <tr>
                <td>B101</td>
                <td>Chennai Express</td>
                <td>Volvo</td>
                <td>08:00 AM</td>
                <td>25</td>
                <td>₹600</td>
            </tr>

            <tr>
                <td>B102</td>
                <td>AP Travels</td>
                <td>Sleeper Coach</td>
                <td>10:00 PM</td>
                <td>18</td>
                <td>₹800</td>
            </tr>

            <tr>
                <td>B103</td>
                <td>City Travels</td>
                <td>Coach</td>
                <td>06:00 PM</td>
                <td>30</td>
                <td>₹500</td>
            </tr>

        </table>

    </section>


    <!-- Bus Category -->
    <section>

        <h2>Bus Categories</h2>

        <ul>
            <li>Volvo Bus</li>
            <li>Sleeper Coach</li>
            <li>AC Coach</li>
            <li>Non-AC Coach</li>
        </ul>

    </section>


    <!-- Book Ticket -->
    <section id="booking">

        <h2>Book Bus Ticket</h2>

        <form>

            <label>Passenger Name:</label>
            <input type="text"
                   placeholder="Enter passenger name">

            <label>Age:</label>
            <input type="number"
                   placeholder="Enter age">

            <label>Gender:</label>

            <select>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
            </select>

            <label>Select Bus:</label>

            <select>
                <option>Chennai Express</option>
                <option>AP Travels</option>
                <option>City Travels</option>
            </select>

            <label>Select Seat:</label>

            <select>
                <option>Seat 1</option>
                <option>Seat 2</option>
                <option>Seat 3</option>
                <option>Seat 4</option>
                <option>Seat 5</option>
            </select>

            <label>Payment Method:</label>

            <select>
                <option>Online Payment</option>
                <option>Offline Payment</option>
            </select>

            <button type="submit">
                Book Ticket
            </button>

        </form>

    </section>


    <!-- Booking History -->
    <section id="history">

        <h2>Booking History</h2>

        <table>

            <tr>
                <th>Ticket ID</th>
                <th>Bus</th>
                <th>Date</th>
                <th>Seat</th>
                <th>Status</th>
            </tr>

            <tr>
                <td>BT101</td>
                <td>Chennai Express</td>
                <td>20-09-2026</td>
                <td>Seat 5</td>
                <td>Confirmed</td>
            </tr>

        </table>

    </section>


    <!-- Cancel Ticket -->
    <section>

        <h2>Cancel Ticket</h2>

        <form>

            <label>Ticket ID:</label>

            <input type="text"
                   placeholder="Enter Ticket ID">

            <button type="submit">
                Cancel Ticket
            </button>

        </form>

    </section>


    <!-- Comments -->
    <section>

        <h2>Comments</h2>

        <form>

            <label>Write your comment:</label>

            <textarea
                placeholder="Enter your comment">
            </textarea>

            <button type="submit">
                Post Comment
            </button>

        </form>

    </section>


    <!-- User Registration -->
    <section>

        <h2>User Registration</h2>

        <form>

            <label>Name:</label>
            <input type="text"
                   placeholder="Enter name">

            <label>Email:</label>
            <input type="email"
                   placeholder="Enter email">

            <label>Password:</label>
            <input type="password"
                   placeholder="Enter password">

            <button type="submit">
                Register
            </button>

        </form>

    </section>


    <!-- Login -->
    <section id="login">

        <h2>User Login</h2>

        <form>

            <label>Email:</label>
            <input type="email"
                   placeholder="Enter email">

            <label>Password:</label>
            <input type="password"
                   placeholder="Enter password">

            <button type="submit">
                Login
            </button>

        </form>

        <p>
            Forgot Password?
        </p>

    </section>


    <!-- Admin -->
    <section>

        <h2>Admin Panel</h2>

        <p>Admin can manage:</p>

        <ul>
            <li>Bus Information</li>
            <li>Bus Categories</li>
            <li>Registered Users</li>
            <li>Bus Schedules</li>
            <li>Seat Availability</li>
            <li>Bookings</li>
            <li>Comments</li>
            <li>Reports</li>
        </ul>

    </section>


    <!-- Contact -->
    <section id="contact">

        <h2>Contact Us</h2>

        <p>Email: busbooking@gmail.com</p>
        <p>Phone: 9876543210</p>
        <p>Address: Chennai, India</p>

    </section>


    <!-- Footer -->
    <footer>

        <p>
            © 2026 Online Bus Ticket Booking
        </p>

    </footer>

</body>

</html>
```
