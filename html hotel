<!DOCTYPE html>
<html>
<head>
    <title>Hotel Room Booking</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <h1>Grand Palace Hotel</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#rooms">Rooms</a>
            <a href="#booking">Booking</a>
            <a href="#about">About Us</a>
            <a href="#contact">Contact</a>
            <a href="#login">Login</a>
        </nav>
    </header>


    <!-- Home -->
    <section id="home" class="home">

        <h2>Welcome to Grand Palace Hotel</h2>

        <p>
            Book comfortable rooms at affordable prices.
        </p>

        <button>Book Now</button>

    </section>


    <!-- Hotel Search -->
    <section id="search">

        <h2>Search Hotel Room</h2>

        <form>

            <label>Destination:</label>
            <input type="text"
                   placeholder="Enter destination">

            <label>Check-in Date:</label>
            <input type="date">

            <label>Check-out Date:</label>
            <input type="date">

            <label>Number of Guests:</label>
            <input type="number"
                   placeholder="Enter guests">

            <button type="submit">
                Search Room
            </button>

        </form>

    </section>


    <!-- Rooms -->
    <section id="rooms">

        <h2>Available Rooms</h2>

        <table>

            <tr>
                <th>Room Type</th>
                <th>Price</th>
                <th>Availability</th>
                <th>Amenities</th>
            </tr>

            <tr>
                <td>Single Room</td>
                <td>₹1500</td>
                <td>Available</td>
                <td>Wi-Fi, TV</td>
            </tr>

            <tr>
                <td>Double Room</td>
                <td>₹2500</td>
                <td>Available</td>
                <td>Wi-Fi, TV, AC</td>
            </tr>

            <tr>
                <td>Deluxe Room</td>
                <td>₹3500</td>
                <td>Available</td>
                <td>Wi-Fi, AC, TV</td>
            </tr>

            <tr>
                <td>Suite Room</td>
                <td>₹5000</td>
                <td>Available</td>
                <td>Wi-Fi, AC, TV, Breakfast</td>
            </tr>

        </table>

    </section>


    <!-- Booking -->
    <section id="booking">

        <h2>Room Booking</h2>

        <form>

            <label>Customer Name:</label>
            <input type="text"
                   placeholder="Enter your name">

            <label>Email:</label>
            <input type="email"
                   placeholder="Enter email">

            <label>Phone:</label>
            <input type="tel"
                   placeholder="Enter phone number">

            <label>Room Type:</label>

            <select>
                <option>Single Room</option>
                <option>Double Room</option>
                <option>Deluxe Room</option>
                <option>Suite Room</option>
            </select>

            <label>Check-in Date:</label>
            <input type="date">

            <label>Check-out Date:</label>
            <input type="date">

            <label>Payment:</label>

            <select>
                <option>Online Payment</option>
                <option>Offline Payment</option>
            </select>

            <button type="submit">
                Confirm Booking
            </button>

        </form>

    </section>


    <!-- Booking History -->
    <section>

        <h2>Booking History</h2>

        <table>

            <tr>
                <th>Booking ID</th>
                <th>Room</th>
                <th>Date</th>
                <th>Status</th>
            </tr>

            <tr>
                <td>HB101</td>
                <td>Deluxe Room</td>
                <td>20-09-2026</td>
                <td>Confirmed</td>
            </tr>

        </table>

    </section>


    <!-- About -->
    <section id="about">

        <h2>About Us</h2>

        <p>
            Grand Palace Hotel provides comfortable rooms,
            quality service and affordable accommodation.
        </p>

    </section>


    <!-- Customer Service -->
    <section>

        <h2>Customer Service Q&A</h2>

        <h3>Can I cancel my booking?</h3>
        <p>Yes, bookings can be cancelled 3 days before arrival.</p>

        <h3>Can I change my booking?</h3>
        <p>Yes, bookings can be modified 3 days before arrival.</p>

    </section>


    <!-- Contact -->
    <section id="contact">

        <h2>Contact Us</h2>

        <p>Email: hotel@gmail.com</p>
        <p>Phone: 9876543210</p>
        <p>Address: Chennai, India</p>

    </section>


    <!-- Login -->
    <section id="login">

        <h2>User Login</h2>

        <form>

            <label>Email:</label>
            <input type="email"
                   placeholder="Enter email">

            <label>Password:</label>
            <input type="password"
                   placeholder="Enter password">

            <button type="submit">
                Login
            </button>

        </form>

    </section>


    <!-- Privacy Policy -->
    <section>

        <h2>Privacy Policy</h2>

        <p>
            Customer information is kept secure and is used
            only for hotel booking and customer service.
        </p>

    </section>


    <!-- Footer -->
    <footer>

        <p>© 2026 Grand Palace Hotel</p>

    </footer>

</body>
</html>
